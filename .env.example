# =============================================================================
# AI Marketing Content Engine — Environment Configuration
# =============================================================================

# Application
APP_NAME=AI Marketing Content Engine
APP_ENV=development
DEBUG=true

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=marketing_engine
POSTGRES_USER=marketing
POSTGRES_PASSWORD=marketing_secret_2024

# Async database URL (constructed from above, or override directly)
DATABASE_URL=postgresql+asyncpg://marketing:marketing_secret_2024@postgres:5432/marketing_engine

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Provider: openai | anthropic | gemini
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# =============================================================================
# LLM Generation Settings
# =============================================================================
LLM_MAX_RETRIES=2
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.7

# =============================================================================
# Backend
# =============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# =============================================================================
# Frontend
# =============================================================================
VITE_API_BASE_URL=http://localhost:8000
